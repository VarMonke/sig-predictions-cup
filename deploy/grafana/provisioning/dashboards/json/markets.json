    {
      "type": "timeseries",
      "title": "Gaps: Kalshi \u2212 Polymarket and SIG ask \u2212 bid",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "sigbot"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, (kalshi_mid - pm_mid) * 100 AS \"Kalshi \u2212 Polymarket\" FROM fair_values WHERE exchange_id = '$exchange' AND kalshi_mid IS NOT NULL AND pm_mid IS NOT NULL AND $__timeFilter(ts) ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "uid": "sigbot"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, (ask - bid) * 100 AS \"SIG ask \u2212 bid\" FROM (\n  (SELECT $__timeFrom()::timestamptz AS time, bid, ask FROM sig_tob\n   WHERE exchange_id = '$exchange' AND ts < $__timeFrom()::timestamptz ORDER BY ts DESC LIMIT 1)\n  UNION ALL\n  SELECT ts, bid, ask FROM sig_tob WHERE exchange_id = '$exchange' AND $__timeFilter(ts)\n  UNION ALL\n  (SELECT least(now(), $__timeTo()::timestamptz), bid, ask FROM sig_tob\n   WHERE exchange_id = '$exchange' AND ts <= $__timeTo()::timestamptz ORDER BY ts DESC LIMIT 1)\n) AS span ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
