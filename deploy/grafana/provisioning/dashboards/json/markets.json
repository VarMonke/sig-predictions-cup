          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(o.ts, '5m'), sum(CASE WHEN o.side = 'yes' THEN o.qty_traded ELSE -o.qty_traded END) AS \"Our fills\" FROM orders o WHERE o.exchange_id = '$exchange' AND o.qty_traded > 0 AND NOT o.shadow AND $__timeFilter(o.ts) GROUP BY 1 ORDER BY 1"
