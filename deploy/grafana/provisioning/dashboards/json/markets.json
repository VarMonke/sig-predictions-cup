  "annotations": {
    "list": [
      {
        "name": "Our fills",
        "datasource": {
          "uid": "sigbot"
        },
        "enable": true,
        "iconColor": "#ff7eb6",
        "target": {
          "refId": "Anno",
          "datasource": {
            "uid": "sigbot"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT o.ts AS time,\n  CASE WHEN (o.strategy = 'exits' OR o.trade_reason = 'INVENTORY_REBALANCE') THEN 'EXIT' ELSE 'ENTRY' END || ' \u00b7 ' || round(o.qty_traded)::int || ' '\n  || upper(o.side) || ' @ ' || round((o.fill_price * 100)::numeric, 1) || 'c'\n  || coalesce(' \u00b7 edge ' || CASE WHEN e.edge_c >= 0 THEN '+' ELSE '' END || e.edge_c || 'c vs fair '\n     || round((f.fair * 100)::numeric, 1) || 'c', '')\n  || ' \u00b7 cost ' || round(o.total_cost::numeric) || ' \u00b7 ' || o.strategy AS text,\n  o.strategy AS tags\nFROM orders o\nLEFT JOIN LATERAL (SELECT fair FROM fair_values fv WHERE fv.exchange_id = o.exchange_id AND fv.ts <= o.ts\n                   ORDER BY fv.ts DESC LIMIT 1) f ON true\nCROSS JOIN LATERAL (SELECT round(((CASE WHEN o.side = 'yes' THEN f.fair - o.fill_price\n                                        ELSE 1 - o.fill_price - f.fair END) * 100)::numeric, 1) AS edge_c) e\nWHERE o.exchange_id = '$exchange' AND o.qty_traded > 0 AND NOT o.shadow AND $__timeFilter(o.ts) ORDER BY 1"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "exchange",
        "label": "Market",
        "type": "query",
        "datasource": {
          "uid": "sigbot"
        },
        "query": "SELECT exchange_id AS __value, race || ' ' || party AS __text FROM races ORDER BY race, party",
        "definition": "SELECT exchange_id AS __value, race || ' ' || party AS __text FROM races ORDER BY race, party",
