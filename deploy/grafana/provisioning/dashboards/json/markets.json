    {
      "type": "table",
      "title": "Signals by race",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "sigbot"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT race AS \"Race\",\n  count(*) FILTER (WHERE decision = 'submitted') AS \"Submitted\",\n  count(*) FILTER (WHERE decision LIKE 'rejected%') AS \"Rejected\",\n  round((sum(edge * quantity) FILTER (WHERE decision = 'submitted') / 1000.0)::numeric, 2) AS \"Expected edge\"\nFROM intents WHERE $__timeFilter(ts)\nGROUP BY 1 ORDER BY 2 DESC, 3 DESC LIMIT 40"
        }
      ],
