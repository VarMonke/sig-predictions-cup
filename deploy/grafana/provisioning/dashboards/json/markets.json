  "panels": [
    {
      "type": "timeseries",
      "title": "$exchange: Kalshi \u00d7 Polymarket \u00d7 SIG book, with our entries and exits",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "sigbot"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, fair AS \"Fair\", pm_mid AS \"Polymarket\", kalshi_mid AS \"Kalshi\" FROM fair_values WHERE exchange_id = '$exchange' AND $__timeFilter(ts) ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "uid": "sigbot"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, bid AS \"SIG bid\", ask AS \"SIG ask\" FROM (\n  (SELECT $__timeFrom()::timestamptz AS time, bid, ask FROM sig_tob\n   WHERE exchange_id = '$exchange' AND ts < $__timeFrom()::timestamptz ORDER BY ts DESC LIMIT 1)\n  UNION ALL\n  SELECT ts, bid, ask FROM sig_tob WHERE exchange_id = '$exchange' AND $__timeFilter(ts)\n  UNION ALL\n  (SELECT least(now(), $__timeTo()::timestamptz), bid, ask FROM sig_tob\n   WHERE exchange_id = '$exchange' AND ts <= $__timeTo()::timestamptz ORDER BY ts DESC LIMIT 1)\n) AS span ORDER BY 1"
        },
        {
          "refId": "C",
          "datasource": {
            "uid": "sigbot"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT o.ts AS time,\n  CASE WHEN NOT (o.strategy = 'exits' OR o.trade_reason = 'INVENTORY_REBALANCE') THEN CASE WHEN o.side = 'yes' THEN o.fill_price ELSE 1 - o.fill_price END END AS \"Entry\",\n  CASE WHEN (o.strategy = 'exits' OR o.trade_reason = 'INVENTORY_REBALANCE') THEN CASE WHEN o.side = 'yes' THEN o.fill_price ELSE 1 - o.fill_price END END AS \"Exit\"\nFROM orders o WHERE o.exchange_id = '$exchange' AND o.qty_traded > 0 AND NOT o.shadow AND $__timeFilter(o.ts) ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
