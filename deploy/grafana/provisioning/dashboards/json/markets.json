      "title": "Sharp moves: confirmed by Kalshi or by waiting",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "sigbot"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE kind = 'sharp_move') AS \"Sharp moves\",\n  count(*) FILTER (WHERE kind = 'sharp_confirmed' AND data->>'by' = 'kalshi') AS \"By Kalshi\",\n  count(*) FILTER (WHERE kind = 'sharp_confirmed' AND data->>'by' = 'timeout') AS \"By timeout\",\n  round((percentile_cont(0.5) WITHIN GROUP (ORDER BY (data->>'after_s')::float)\n    FILTER (WHERE kind = 'sharp_confirmed' AND data->>'by' = 'kalshi'))::numeric, 2)\n    AS \"Median Kalshi confirm (s)\"\nFROM events WHERE kind IN ('sharp_move', 'sharp_confirmed') AND $__timeFilter(ts)"
        }
