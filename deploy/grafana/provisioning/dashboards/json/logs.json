{
  "uid": "sigbot-logs",
  "title": "Sigbot - Logs",
  "tags": [
    "sigbot"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "sigbot"
      ],
      "asDropdown": false,
      "title": "Sigbot"
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "INFO,WARNING,ERROR,CRITICAL",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Log lines per minute",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "sigbot"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), level AS metric, count(*) AS value FROM logs WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "linear"
          }
        },
        "overrides": []
      },
      "id": 1,
      "datasource": {
        "uid": "sigbot"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      }
    },
    {
      "type": "table",
      "title": "Bot log (newest first)",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "sigbot"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"Time\", level AS \"Level\", logger AS \"Source\", message AS \"Message\"\nFROM logs WHERE level IN ($level) AND $__timeFilter(ts)\nORDER BY ts DESC LIMIT 500"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Level"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "CRITICAL": {
                        "color": "red",
                        "index": 0
                      },
                      "ERROR": {
                        "color": "red",
                        "index": 1
                      },
                      "WARNING": {
                        "color": "orange",
                        "index": 2
                      },
                      "INFO": {
                        "color": "text",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "id": 2,
      "datasource": {
        "uid": "sigbot"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 22
      }
    }
  ]
}
