# Copy to .env and fill in. NEVER commit .env.
API_KEY=your-sig-api-key

# Deployment (required for docker compose)
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
DOMAIN=sig.example.com
CONTROL_TOKEN=change-me-long-random

# Trading (leave unset = shadow mode; no orders are placed)
# TRADING_ENABLED=true

# Risk limits for tier 1 (higher tiers scale them). Defaults shown; uncomment to change.
# RISK_MAX_DEPLOYED_FRAC=0.20        # share of equity in open positions
# RISK_MAX_RACE_LOSS=2000            # loss cap per race result, weighted by its stressed probability (a coin
#                                    # flip counts in full, a 1% long shot 5%); x0.5 one source, x0.25 shaky
# RISK_MAX_RACE_LOSS_FRAC=0.12       # hard ceiling: plain loss in any one race result <= this share of equity
# RISK_MAX_TAIL_LOSS_FRAC=0.5        # cap on one party's wave loss across all races (NO on its long shots + YES on
#                                    # the other party's favourites, at cost), as a share of equity
# RISK_MAX_ORDER_NOTIONAL=1000       # per order
# RISK_MAX_SWING_LOSS_FRAC=0.03      # max loss if every race moves ~7c against us at once
# RISK_DAILY_LOSS_FRAC=0.02          # halt for the day after this loss
# RISK_DRAWDOWN_STEP_DOWN_FRAC=0.01  # drop a tier this far below the day's peak
# RISK_MAX_BOOK_AGE_S=10             # never trade on older SIG prices
# RISK_TIER_DEPLOYED=0.30,0.35,0.50,0.65  # deployed share per tier 1-4 (overrides scaling from tier 1)
# RISK_START_TIER=1                  # tier at boot, as if set with /tier (no auto promotion; drawdowns step down)
# Carry cap (off at 1): SIG's own level per market (the "band", a 30-minute median of its mid, band.py) splits
# every buy in two: under the band it can be sold back within minutes (round-trip material, free); at or above
# it only settlement pays (carry: SIG marks it under cost for a month, 85% of the book on 2026-10-04). Capital
# in carry positions (those the band does not pay cost + 1c for) stays under this share of equity. 0 = never
# buy at or above the band (a level cap plus any standing sell rule is a pump: 2026-10-04, -15k).
# RISK_CARRY_CAP_FRAC=0
# The daily-loss halt measures the UTC day from the day's first recorded equity (seeded from the database on
# restart). Set this to re-base the reference deliberately (first recorded equity at or after it; only the day
# it falls in), e.g. after a loss whose cause has been removed.
# RISK_DAILY_LOSS_FROM=2026-10-05T05:15Z
# SNIPE_KELLY_FRACTION=0.35          # share of the Kelly stake a snipe takes (code default 0.25)
# SNIPE_MIN_ROC=0.08                 # edge per unit of capital a snipe needs (raised to EXIT_HURDLE + 0.03)
# ARB_MIN_ROC=0                      # profit per set over its cost an arb needs (raised to EXIT_HURDLE + 0.03)
# EXIT_HURDLE=0                      # sell holds/arb sets whose remaining return to settlement is <= this (0.05 = 5%)
# EXIT_HURDLE_MAX_LOSS_C=0           # cents below cost a hurdle exit may sell at (per share; per leg of an arb set);
#                                    # a losing sale never takes a market's booked P&L below zero (win rate)
# EXIT_HURDLE_PER_DAY=0              # sell holds earning <= this per day of trading left (0.005 = 0.5%/day; 0 = off)
# EXIT_RECYCLE_LOPSIDED=false        # sell lopsided positions whenever the market pays >= cost (+ margin) to free capital
# EXIT_RECYCLE_MARGIN_C=0            # cents above cost a recycle exit must realize
# Unwind (a deliberate, user-approved liquidation; off unless EXCHANGES is set): from AFTER on, the positions
# held at that moment on these exchanges (or every carry position with `carry`) are sold at the inside down to
# MAX_LOSS_C under cost. ONE-SHOT: positions opened later never qualify. Until then the ladder's flips rest at
# cost or better, so only what did not fill that way takes the loss. Remove the knobs once it is done.
# EXIT_UNWIND_EXCHANGES=carry        # exchange ids, or carry
# EXIT_UNWIND_AFTER=2026-10-04T15:00Z
# EXIT_UNWIND_MAX_LOSS_C=4

# Flow trading (resting quotes inside SIG's spread); off unless MM_MARKETS is set. Pause: /pause quote
# MM_MARKETS=SEN-ME,HOUSE-PA-07,all   # race keys (every outcome), exchange ids, or "all" (every market with
#                                     # fair between MM_BAND_C and 1 - MM_BAND_C), named ones first
# MM_BAND_C=15                        # 0 = every market, long shots included (the venue's own price is the anchor)
# MM_TOP_N=25                         # with all: only the N most active band markets by shares printed (0 = all)
# MM_HALF_SPREAD_C=3                  # quote the anchor (SIG's mid, or fair) +/- this many cents when that improves the inside
# MM_MIN_HALF_SPREAD_C=0.5            # join the inside when it is at least this far from the anchor
# MM_MAX_SPREAD_C=8                   # anchor on SIG's mid when the others' spread is at most this; else on fair.
#                                     # A one-sided book gets no new quotes.
# MM_FAIR_GUARD_C=5                   # per side: a quote buying a side more than this above its worth (fair for YES,
#                                     # 1 - fair for NO) only closes the quoter's own inventory; below worth: full size
# MM_RICH_SIDE_FRAC=0.5               # size multiplier for a quote buying a side above its fair but within the guard
# MM_SIZE=100                         # shares per quote
# MM_MAX_INVENTORY=500                # shares per exchange either way, counting every quote still resting on
#                                     # that side: keep it a few MM_SIZE or re-quotes wait for old ones to expire
# MM_EXPIRY_S=60                      # SIG cancels each quote by itself after this; renewed 15 s before
# MM_BUDGET_FRAC=0.15                 # collateral resting in quotes at most, as a share of equity
# MM_INVENTORY_FRAC=0.15              # positions on quoted markets at most; above it only the reducing side is quoted
# MM_CASH_MULTIPLE=1.0                # resting quotes may reserve this multiple of cash (SIG locks no collateral at placement)
# MM_BATCH_SIZE=25                    # quotes per /orders/batch request (max 50)
# MM_ACTIONS_PER_S=0.25               # batch placements + cancels per second (capped at 0.25: SIG allows 30 writes/min per key)
# SIG_SCAN_EVERY_S=5                  # full poll of every SIG book (8 frees request budget for quoting)
# PAUSED_STRATEGIES=arb               # paused from startup (/pause lives in memory only)

# Sweep catching (resting limits far from fair, one tick inside the crowd's walls, for market orders that
# sweep whole books); off unless SWEEP_MARKETS is set. Pause: /pause sweep. See src/sigbot/strategies/sweep.py.
# SWEEP_MARKETS=SEN-RI,SEN-OK,SEN-MA,CTRL-HOUSE,all  # race keys / exchange ids get whole ladders first;
#                                     # "all" adds every market with fair <= SWEEP_BAND_C or >= 1 - it
# SWEEP_BAND_C=20                     # lopsided means fair within this many cents of 0 or 1
# SWEEP_FLOOR_C=30                    # never rest closer to fair than this
# SWEEP_SECONDARY_C=30,50,70          # smaller rungs at these distances from fair, for partial sweeps
# SWEEP_SIZE=10000                    # shares on the primary rung (inside the first wall of >= SWEEP_WALL)
# SWEEP_SECONDARY_SIZE=2000
# SWEEP_WALL=20000                    # a resting level this big is a wall; smaller orders are competitors
# SWEEP_LEVEL_COST=1200               # collateral cap per rung (quantity is cut to cost / price)
# SWEEP_MAX_RUNG_COST_C=20            # collateral per share at most: rungs rest at the cheap extremes
# SWEEP_BUDGET_FRAC=0.25              # collateral resting in rungs at most, as a share of equity
# SWEEP_CASH_MULTIPLE=1.0             # resting rungs may reserve this multiple of cash
# SWEEP_RELEVEL_C=5                   # rebuild a market's ladder once fair moved this far
# SWEEP_REQUOTE_MIN_S=20              # move inside an undercutting crowd at most this often per market
# SWEEP_EXPIRY_S=1800                 # SIG cancels each rung by itself after this; renewed 2 min before
# SWEEP_BATCH_SIZE=10                 # rungs per /orders/batch request (max 50)
# SWEEP_DEPTH=60                      # book levels fetched per market in scope (the crowd sits deep)
# Dump catching: setting SWEEP_ROC_LEVELS switches the ladder to BUY limits on the favourite's side of each
# lopsided market at the prices returning these levels to settlement at fair (whales dumping favourites
# 4-15% under fair walk into them). FLOOR/SECONDARY_C/WALL/MAX_RUNG_COST/DEPTH are then unused; rungs are
# budgeted per race against RISK_MAX_RACE_LOSS_FRAC as if all filled. Keep the levels >= SNIPE_MIN_ROC (the
# hurdle exit would sell a shallower fill straight back) and SWEEP_LEVEL_COST high enough for 90c shares.
# SWEEP_ROC_LEVELS=0.08,0.11,0.15     # first level first (placed in every market before any second level)
# SWEEP_ROC_SIZES=8000,8000,10000     # shares per level (the last repeats); cut to SWEEP_LEVEL_COST
# SWEEP_RELEVEL_C=1.5                 # value rungs follow fair: rebuild on this move (no per-tick requotes)
# Both at once: SWEEP_FAR=true places the far geometry (FLOOR/SECONDARY_C/SIZE/SECONDARY_SIZE/WALL/MAX_RUNG_COST/
# DEPTH apply again, slots 10+) beside the value rungs, with its own share of the budget. Spikes of 500k+
# shares reach 25-62c on 2c long shots several times a day (2026-10-03) and revert within the hour.
# SWEEP_FAR=false
# SWEEP_FAR_FRAC=0.5                  # share of the ladder budget for the far rungs (nearest rung first, every market)
# SWEEP_BEHIND_WALLS=false            # true: far secondaries are placed behind the crowd's walls too (dense books)
# Band-relative dump catching (2026-10-04; replaces SWEEP_ROC_LEVELS when set): rungs sit these many cents under
# SIG's own level (band.py) on the favourite's side, never closer to fair than DUMP_MIN_EDGE_C, none without a
# band (the first ~10 min after a start). Fair-priced rungs sat above the band on the favourites SIG discounts
# for days and bought carry. Sizes from SWEEP_ROC_SIZES.
# SWEEP_DUMP_OFFSETS_C=6,9,13
# SWEEP_DUMP_MIN_EDGE_C=2
# Flips: every position on a ladder market gets a resting sell at the better of band - MARGIN and cost +
# MIN_PROFIT (marketable when the inside already pays it): the round trip for dump fills within minutes, and a
# no-loss exit for carry whenever the venue dips to it. Flips rest no collateral and go first in every batch.
# SWEEP_FLIP=true
# SWEEP_FLIP_MARGIN_C=1
# SWEEP_FLIP_MIN_PROFIT_C=1
# The carry bucket (2026-10-11): on long shots worth <= CARRY_MAX_FAIR_C the asks rest LONGSHOT_OFFSETS_C over
# the band instead of DUMP_OFFSETS_C (1c is lifted by the crowd's ordinary long-shot buying: SEN-RI R traded
# 8.7M shares at 10-20c in three days against a 0.9% fair). HOLD_FRAC: while positions are at most this share
# of equity, fills on sides worth >= 95c are kept to settlement (NO on a 1% long shot pays ~0.99) instead of
# flipped; above it the flips resume. 0 = always flip.
# SWEEP_LONGSHOT_OFFSETS_C=1,3,6
# SWEEP_CARRY_MAX_FAIR_C=3
# SWEEP_HOLD_FRAC=0.35

# Capital recycling (swap valve): when the deployed cap rejects a trade, sell just enough of the slowest
# position at >= cost to let it through (see src/sigbot/strategies/recycle.py). Pause: /pause recycle
# RECYCLE_ENABLED=true
# RECYCLE_MARGIN=0.05                 # the trade's return on capital must beat the position's forgone rate by this
# RECYCLE_MIN_FREE=50                 # smallest swap worth an order (SUSQies freed)
# RECYCLE_COOLDOWN_S=30               # no second swap out of the same market within this long
# RECYCLE_MAX_PER_MINUTE=6
# RECYCLE_TURNOVER_DAYS=0             # > 0: a swap counts the trade's return once per turnover it can make before
#                                     # settlement (2 = a 3% round trip 31 days out counts 46%), against the hold's one
# RECYCLE_SWAP_MAX_LOSS_C=0           # cents under cost a swap may sell at (never past the market's booked gains)
# Cash reserve (off at 0): while cash < this share of equity, sell the positions with the least edge left per
# SUSQie, cheapest first, until it is back (the dump catcher needs cash behind its rungs). Keep it below
# 1 - the tier's deployed cap, or snipes and the reserve trade the same capital back and forth.
# RECYCLE_RESERVE_FRAC=0.25
# RECYCLE_RESERVE_MAX_RATE=0.10       # never sell a position still earning more than this to settlement
# RECYCLE_RESERVE_MAX_LOSS_C=0        # cents under cost the reserve may sell at
# RECYCLE_RESERVE_EVERY_S=10
# SIG_BUDGET_PER_MIN=90               # lower (e.g. 30) for a shadow run beside the live bot on the same key

# Optional Discord alerts/controls (IDs are not secrets)
# DISCORD_BOT_TOKEN=...
DISCORD_ALERT_CHANNEL_ID=1554386830261223498
